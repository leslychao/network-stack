# Copy this entire file into the ONE GitHub Actions secret DEPLOY_ENV.
# One KEY=value per line. Single quotes preserve $, # and spaces literally.
# Base64 fields must be single-line. Never commit the completed file.
SSH_HOST=
SSH_USER=
SSH_PRIVATE_KEY_B64=
SSH_KNOWN_HOSTS_B64=

# Public IPv4 address; no owned domain or email is required.
PANEL_HOST=
# Used only until the initial setup completes. Later changes belong in 3x-ui.
INITIAL_PANEL_USERNAME=
INITIAL_PANEL_PASSWORD=
INITIAL_VLESS_UUID=
INITIAL_REALITY_PRIVATE_KEY=
INITIAL_REALITY_PUBLIC_KEY=
INITIAL_REALITY_SHORT_ID=
# Hex FakeTLS secret: ee + 16 random bytes + UTF-8 domain, all hex-encoded.
MTG_SECRET=
